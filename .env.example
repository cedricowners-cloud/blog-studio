# ============================================================
# blog_studio 환경변수 템플릿 (이 파일은 git에 커밋됨)
# ============================================================
# 실제 값은 절대 이 파일에 입력하지 말 것.
# 컴포넌트별로 다음 위치에 복사 후 채워넣음:
#   - web → web/.env.local
#   - content_service → content_service/.env (필요 시)
#   - local_agent → local_agent/.env (필요 시)
#   - root → blog_studio/.env (Supabase MCP 인증 전용)
# ============================================================


# ---------- Supabase (root .env — MCP용) ----------
# https://supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_REF=YOUR-PROJECT-REF
SUPABASE_ACCESS_TOKEN=sbp_...


# ============================================================
# web/.env.local 에 들어갈 값들
# ============================================================

# ---------- Supabase 클라이언트 ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# service_role: 서버 사이드 전용 (절대 NEXT_PUBLIC_ 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- LLM ----------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- 네이버 검색 API (블로그/뉴스 검색) ----------
# https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------- 네이버 검색광고 API (키워드 분석) ----------
# https://manage.searchad.naver.com → 도구 → API 사용 관리
NAVER_SEARCH_ACCESS_LICENSE_KEY=
NAVER_SEARCH_SECRET_KEY=
NAVER_SEARCH_CUSTOMER_ID=

# ---------- 이미지 ----------
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=


# ============================================================
# local_agent/.env 에 들어갈 값들 (선택)
# ============================================================
# 네이버 계정 비밀번호는 절대 여기에 저장하지 말 것 — local_agent/secrets.py가 암호화 저장
AGENT_ID=  # 첫 실행 시 자동 생성됨
