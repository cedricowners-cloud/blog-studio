# ============================================================
# blog_studio/web — Next.js 환경변수 템플릿
# ============================================================
# 이 파일은 git에 커밋됨. 실제 값은 web/.env.local 에 입력 (gitignored)
# Vercel 배포 시에는 모두 Vercel 대시보드 → Settings → Environment Variables 에 등록.
#
# 규칙:
# - NEXT_PUBLIC_* 접두사: 브라우저로 노출됨. 공개 가능한 값만.
# - 접두사 없음: 서버 사이드 전용 (API routes, Server Components). 절대 클라이언트 코드에서 참조 금지.
# ============================================================

# ---------- Supabase (브라우저 + 서버) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# service_role: 서버 사이드 전용. RLS 우회 권한이라 절대 NEXT_PUBLIC_ 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------- 외부 content_service (옵션) ----------
# 비워두면 Next.js API routes 사용. 외부 FastAPI를 쓰고 싶을 때만 채움.
# NEXT_PUBLIC_CONTENT_SERVICE_URL=http://localhost:8000

# ============================================================
# 서버 사이드 API 키 (web/app/api/* 라우트에서 사용)
# ============================================================

# ---------- 네이버 검색 API (블로그 검색) ----------
# 발급: https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---------- 네이버 검색광고 API (키워드 분석) ----------
# 발급: https://manage.searchad.naver.com → 도구 → API 사용 관리
NAVER_SEARCH_ACCESS_LICENSE_KEY=
NAVER_SEARCH_SECRET_KEY=
NAVER_SEARCH_CUSTOMER_ID=

# ---------- LLM (글 생성, 카드뉴스 변환) ----------
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- 이미지 검색 ----------
# 발급: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# 발급: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
